<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::system">
                    <resource id="Magento_Backend::convert">
                        <resource id="Iranimij_OpenImport::openimport" title="OpenImport" translate="title" sortOrder="70">
                            <resource id="Iranimij_OpenImport::profiles" title="View profiles" translate="title" sortOrder="10"/>
                            <resource id="Iranimij_OpenImport::profiles_edit" title="Create and edit profiles" translate="title" sortOrder="20"/>
                            <resource id="Iranimij_OpenImport::run" title="Run profiles (dry run and live)" translate="title" sortOrder="30"/>
                            <resource id="Iranimij_OpenImport::run_destructive" title="Confirm runs above the safety limit" translate="title" sortOrder="40"/>
                            <resource id="Iranimij_OpenImport::runs" title="View runs and error reports" translate="title" sortOrder="50"/>
                            <resource id="Iranimij_OpenImport::run_files" title="Download run files (the imported file, the export)" translate="title" sortOrder="55"/>
                            <resource id="Iranimij_OpenImport::connections" title="Manage connections" translate="title" sortOrder="60"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Iranimij_Base::config">
                                <resource id="Iranimij_OpenImport::config" title="OpenImport" translate="title" sortOrder="30"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
