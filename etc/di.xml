<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Iranimij\OpenImport\Api\Data\ProfileInterface" type="Iranimij\OpenImport\Model\Profile"/>
    <preference for="Iranimij\OpenImport\Api\Data\RunInterface" type="Iranimij\OpenImport\Model\Run"/>
    <preference for="Iranimij\OpenImport\Api\ProfileRepositoryInterface"
                type="Iranimij\OpenImport\Model\ProfileRepository"/>
    <preference for="Iranimij\OpenImport\Api\RunRepositoryInterface" type="Iranimij\OpenImport\Model\RunRepository"/>
    <preference for="Iranimij\OpenImport\Api\Data\ProfileSearchResultsInterface"
                type="Iranimij\OpenImport\Model\ProfileSearchResults"/>
    <preference for="Iranimij\OpenImport\Api\Data\RunSearchResultsInterface"
                type="Iranimij\OpenImport\Model\RunSearchResults"/>

    <virtualType name="Iranimij\OpenImport\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/openimport.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">openimport</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Iranimij\OpenImport\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Iranimij\OpenImport\Model\Execution\RunProcessor">
        <arguments>
            <argument name="logger" xsi:type="object">Iranimij\OpenImport\Logger</argument>
        </arguments>
    </type>

    <!-- OpenImport's own importers; every other entity goes through core's import engine. -->
    <type name="Iranimij\OpenImport\Model\Bridge\ImporterPool">
        <arguments>
            <argument name="importers" xsi:type="array">
                <item name="openimport_category" xsi:type="object">Iranimij\OpenImport\Model\Import\Category\CategoryImporter</item>
                <item name="openimport_attribute" xsi:type="object">Iranimij\OpenImport\Model\Import\Attribute\AttributeImporter</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\Entity\RecordReaderPool">
        <arguments>
            <argument name="readers" xsi:type="array">
                <item name="catalog_product" xsi:type="object">Iranimij\OpenImport\Model\Entity\Reader\ProductRecordReader</item>
                <item name="openimport_stock_price" xsi:type="object">Iranimij\OpenImport\Model\Entity\Reader\ProductRecordReader</item>
                <item name="customer" xsi:type="object">Iranimij\OpenImport\Model\Entity\Reader\CustomerRecordReader</item>
                <item name="customer_composite" xsi:type="object">Iranimij\OpenImport\Model\Entity\Reader\CustomerRecordReader</item>
                <item name="openimport_category" xsi:type="object">Iranimij\OpenImport\Model\Import\Category\CategoryRecordReader</item>
                <item name="openimport_attribute" xsi:type="object">Iranimij\OpenImport\Model\Import\Attribute\AttributeRecordReader</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="openimport_run" xsi:type="object">Iranimij\OpenImport\Console\Command\RunCommand</item>
                <item name="openimport_run_status" xsi:type="object">Iranimij\OpenImport\Console\Command\RunStatusCommand</item>
                <item name="openimport_profile_list" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfileListCommand</item>
                <item name="openimport_queue_run" xsi:type="object">Iranimij\OpenImport\Console\Command\QueueRunCommand</item>
                <item name="openimport_secrets_reencrypt" xsi:type="object">Iranimij\OpenImport\Console\Command\SecretsReencryptCommand</item>
                <item name="openimport_profiles_export" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfilesExportCommand</item>
                <item name="openimport_profiles_import" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfilesImportCommand</item>
                <item name="openimport_doctor" xsi:type="object">Iranimij\OpenImport\Console\Command\DoctorCommand</item>
            </argument>
        </arguments>
    </type>
    <!-- Commands are built on every bin/magento call: load their heavy dependencies only when they run. -->
    <type name="Iranimij\OpenImport\Console\Command\RunCommand">
        <arguments>
            <argument name="processor" xsi:type="object">Iranimij\OpenImport\Model\Execution\RunProcessor\Proxy</argument>
            <argument name="queue" xsi:type="object">Iranimij\OpenImport\Model\Execution\RunQueue\Proxy</argument>
            <argument name="profiles" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfileFinder\Proxy</argument>
            <argument name="report" xsi:type="object">Iranimij\OpenImport\Console\Command\RunReport\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\QueueRunCommand">
        <arguments>
            <argument name="processor" xsi:type="object">Iranimij\OpenImport\Model\Execution\RunProcessor\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\RunStatusCommand">
        <arguments>
            <argument name="runs" xsi:type="object">Iranimij\OpenImport\Api\RunRepositoryInterface\Proxy</argument>
            <argument name="report" xsi:type="object">Iranimij\OpenImport\Console\Command\RunReport\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\ProfilesExportCommand">
        <arguments>
            <argument name="profiles" xsi:type="object">Iranimij\OpenImport\Api\ProfileRepositoryInterface\Proxy</argument>
            <argument name="finder" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfileFinder\Proxy</argument>
            <argument name="json" xsi:type="object">Iranimij\OpenImport\Model\Profile\ProfileJson\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\ProfilesImportCommand">
        <arguments>
            <argument name="json" xsi:type="object">Iranimij\OpenImport\Model\Profile\ProfileJson\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\DoctorCommand">
        <arguments>
            <argument name="indexers" xsi:type="object">Magento\Framework\Indexer\IndexerRegistry\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\SecretsReencryptCommand">
        <arguments>
            <argument name="profiles" xsi:type="object">Iranimij\OpenImport\Api\ProfileRepositoryInterface\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\ProfileListCommand">
        <arguments>
            <argument name="profiles" xsi:type="object">Iranimij\OpenImport\Api\ProfileRepositoryInterface\Proxy</argument>
            <argument name="runs" xsi:type="object">Iranimij\OpenImport\Api\RunRepositoryInterface\Proxy</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="openimport_profile_listing_data_source" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Profile\Grid\Collection</item>
                <item name="openimport_run_listing_data_source" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Run\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Iranimij\OpenImport\Model\ResourceModel\Profile\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">openimport_profile</argument>
            <argument name="resourceModel" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Profile</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\ResourceModel\Run\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">openimport_run</argument>
            <argument name="resourceModel" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Run</argument>
        </arguments>
    </virtualType>

    <type name="Iranimij\OpenImport\Model\Execution\SourceResolver">
        <arguments>
            <argument name="sources" xsi:type="array">
                <item name="upload" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\UploadSource</item>
                <item name="folder" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\FolderSource</item>
                <item name="url" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\UrlSource</item>
                <item name="sftp" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\SftpSource</item>
                <item name="ftp" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\FtpSource</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Iranimij\OpenImport\Model\Execution\Source\SftpSource" type="Iranimij\OpenImport\Model\Execution\Source\RemoteSource">
        <arguments>
            <argument name="protocol" xsi:type="string">sftp</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Execution\Source\FtpSource" type="Iranimij\OpenImport\Model\Execution\Source\RemoteSource">
        <arguments>
            <argument name="protocol" xsi:type="string">ftp</argument>
        </arguments>
    </virtualType>
    <type name="Iranimij\OpenImport\Model\Writer\WriterFactory">
        <arguments>
            <argument name="writers" xsi:type="array">
                <item name="csv" xsi:type="string">Iranimij\OpenImport\Model\Writer\CsvWriter</item>
                <item name="xlsx" xsi:type="string">Iranimij\OpenImport\Model\Writer\XlsxWriter</item>
                <item name="json" xsi:type="string">Iranimij\OpenImport\Model\Writer\JsonWriter</item>
                <item name="xml" xsi:type="string">Iranimij\OpenImport\Model\Writer\XmlWriter</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\Export\EntitySourcePool">
        <arguments>
            <argument name="sources" xsi:type="array">
                <item name="openimport_order" xsi:type="object">Iranimij\OpenImport\Model\Export\Order\OrderEntitySource</item>
                <item name="openimport_category" xsi:type="object">Iranimij\OpenImport\Model\Import\Category\CategoryEntitySource</item>
                <item name="openimport_attribute" xsi:type="object">Iranimij\OpenImport\Model\Import\Attribute\AttributeEntitySource</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Iranimij\OpenImport\Model\Export\Destination\SftpDestination" type="Iranimij\OpenImport\Model\Export\Destination\RemoteDestination">
        <arguments>
            <argument name="protocol" xsi:type="string">sftp</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Export\Destination\FtpDestination" type="Iranimij\OpenImport\Model\Export\Destination\RemoteDestination">
        <arguments>
            <argument name="protocol" xsi:type="string">ftp</argument>
        </arguments>
    </virtualType>
    <type name="Iranimij\OpenImport\Model\Export\DestinationPool">
        <arguments>
            <argument name="destinations" xsi:type="array">
                <item name="download" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\DownloadDestination</item>
                <item name="folder" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\FolderDestination</item>
                <item name="sftp" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\SftpDestination</item>
                <item name="ftp" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\FtpDestination</item>
                <item name="email" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\EmailDestination</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\Execution\Source\Remote\RemoteClientFactory">
        <arguments>
            <argument name="clients" xsi:type="array">
                <item name="sftp" xsi:type="string">Iranimij\OpenImport\Model\Execution\Source\Remote\SftpClient</item>
                <item name="ftp" xsi:type="string">Iranimij\OpenImport\Model\Execution\Source\Remote\FtpClient</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\Schedule\Scheduler">
        <arguments>
            <argument name="logger" xsi:type="object">Iranimij\OpenImport\Logger</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Cron\Tick">
        <arguments>
            <argument name="logger" xsi:type="object">Iranimij\OpenImport\Logger</argument>
            <argument name="processor" xsi:type="object">Iranimij\OpenImport\Model\Execution\RunProcessor\Proxy</argument>
        </arguments>
    </type>
</config>
