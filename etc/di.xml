<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Iranimij\OpenImport\Api\Data\ProfileInterface" type="Iranimij\OpenImport\Model\Profile"/>
    <preference for="Iranimij\OpenImport\Api\Data\RunInterface" type="Iranimij\OpenImport\Model\Run"/>
    <preference for="Iranimij\OpenImport\Api\RunManagementInterface" type="Iranimij\OpenImport\Model\Api\RunManagement"/>
    <preference for="Iranimij\OpenImport\Api\Data\RunStartResultInterface" type="Iranimij\OpenImport\Model\Api\RunStartResult"/>
    <preference for="Iranimij\OpenImport\Api\ProfileRepositoryInterface"
                type="Iranimij\OpenImport\Model\ProfileRepository"/>
    <preference for="Iranimij\OpenImport\Api\RunRepositoryInterface" type="Iranimij\OpenImport\Model\RunRepository"/>
    <preference for="Iranimij\OpenImport\Api\Data\ConnectionInterface" type="Iranimij\OpenImport\Model\Connection"/>
    <preference for="Iranimij\OpenImport\Api\ConnectionRepositoryInterface"
                type="Iranimij\OpenImport\Model\ConnectionRepository"/>
    <preference for="Iranimij\OpenImport\Api\Data\ProfileSearchResultsInterface"
                type="Iranimij\OpenImport\Model\ProfileSearchResults"/>
    <preference for="Iranimij\OpenImport\Api\Data\RunSearchResultsInterface"
                type="Iranimij\OpenImport\Model\RunSearchResults"/>

    <virtualType name="Iranimij\OpenImport\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/openimport.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">openimport</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Iranimij\OpenImport\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Iranimij\OpenImport\Model\Execution\RunProcessor">
        <arguments>
            <argument name="logger" xsi:type="object">Iranimij\OpenImport\Logger</argument>
        </arguments>
    </type>

    <!-- CMS pages and blocks: one importer, reader and export source per kind. -->
    <virtualType name="OpenImportCmsPageImporter" type="Iranimij\OpenImport\Model\Import\Cms\CmsImporter">
        <arguments>
            <argument name="kind" xsi:type="string">page</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCmsPageReader" type="Iranimij\OpenImport\Model\Import\Cms\CmsRecordReader">
        <arguments>
            <argument name="kind" xsi:type="string">page</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCmsPageSource" type="Iranimij\OpenImport\Model\Import\Cms\CmsEntitySource">
        <arguments>
            <argument name="kind" xsi:type="string">page</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCmsBlockImporter" type="Iranimij\OpenImport\Model\Import\Cms\CmsImporter">
        <arguments>
            <argument name="kind" xsi:type="string">block</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCmsBlockReader" type="Iranimij\OpenImport\Model\Import\Cms\CmsRecordReader">
        <arguments>
            <argument name="kind" xsi:type="string">block</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCmsBlockSource" type="Iranimij\OpenImport\Model\Import\Cms\CmsEntitySource">
        <arguments>
            <argument name="kind" xsi:type="string">block</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCartRuleImporter" type="Iranimij\OpenImport\Model\Import\PriceRule\PriceRuleImporter">
        <arguments>
            <argument name="kind" xsi:type="string">cart</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCartRuleSource" type="Iranimij\OpenImport\Model\Import\PriceRule\PriceRuleEntitySource">
        <arguments>
            <argument name="kind" xsi:type="string">cart</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCartRuleReader" type="Iranimij\OpenImport\Model\Import\PriceRule\PriceRuleRecordReader">
        <arguments>
            <argument name="source" xsi:type="object">OpenImportCartRuleSource</argument>
            <argument name="kind" xsi:type="string">cart</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCatalogRuleImporter" type="Iranimij\OpenImport\Model\Import\PriceRule\PriceRuleImporter">
        <arguments>
            <argument name="kind" xsi:type="string">catalog</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCatalogRuleSource" type="Iranimij\OpenImport\Model\Import\PriceRule\PriceRuleEntitySource">
        <arguments>
            <argument name="kind" xsi:type="string">catalog</argument>
        </arguments>
    </virtualType>
    <virtualType name="OpenImportCatalogRuleReader" type="Iranimij\OpenImport\Model\Import\PriceRule\PriceRuleRecordReader">
        <arguments>
            <argument name="source" xsi:type="object">OpenImportCatalogRuleSource</argument>
            <argument name="kind" xsi:type="string">catalog</argument>
        </arguments>
    </virtualType>
    <!-- OpenImport's own importers; every other entity goes through core's import engine. -->
    <type name="Iranimij\OpenImport\Model\Bridge\ImporterPool">
        <arguments>
            <argument name="importers" xsi:type="array">
                <item name="openimport_category" xsi:type="object">Iranimij\OpenImport\Model\Import\Category\CategoryImporter</item>
                <item name="openimport_attribute" xsi:type="object">Iranimij\OpenImport\Model\Import\Attribute\AttributeImporter</item>
                <item name="openimport_cms_page" xsi:type="object">OpenImportCmsPageImporter</item>
                <item name="openimport_cms_block" xsi:type="object">OpenImportCmsBlockImporter</item>
                <item name="openimport_shipment" xsi:type="object">Iranimij\OpenImport\Model\Import\Shipment\ShipmentImporter</item>
                <item name="openimport_url_rewrite" xsi:type="object">Iranimij\OpenImport\Model\Import\UrlRewrite\UrlRewriteImporter</item>
                <item name="openimport_cart_rule" xsi:type="object">OpenImportCartRuleImporter</item>
                <item name="openimport_catalog_rule" xsi:type="object">OpenImportCatalogRuleImporter</item>
                <item name="openimport_order" xsi:type="object">Iranimij\OpenImport\Model\Import\Order\OrderImporter</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\Pipeline\Step\RowStepPool">
        <arguments>
            <argument name="steps" xsi:type="array">
                <item name="images" xsi:type="object">Iranimij\OpenImport\Model\Image\ImageStep</item>
                <item name="url_keys" xsi:type="object">Iranimij\OpenImport\Model\UrlKey\UrlKeyStep</item>
                <item name="configurable" xsi:type="object">Iranimij\OpenImport\Model\Configurable\ConfigurableStep</item>
                <item name="stock" xsi:type="object">Iranimij\OpenImport\Model\Stock\StockChangeStep</item>
                <item name="missing" xsi:type="object">Iranimij\OpenImport\Model\Missing\MissingProductsStep</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\Entity\RecordReaderPool">
        <arguments>
            <argument name="readers" xsi:type="array">
                <item name="catalog_product" xsi:type="object">Iranimij\OpenImport\Model\Entity\Reader\ProductRecordReader</item>
                <item name="openimport_stock_price" xsi:type="object">Iranimij\OpenImport\Model\Entity\Reader\ProductRecordReader</item>
                <item name="customer" xsi:type="object">Iranimij\OpenImport\Model\Entity\Reader\CustomerRecordReader</item>
                <item name="customer_composite" xsi:type="object">Iranimij\OpenImport\Model\Entity\Reader\CustomerRecordReader</item>
                <item name="openimport_category" xsi:type="object">Iranimij\OpenImport\Model\Import\Category\CategoryRecordReader</item>
                <item name="openimport_attribute" xsi:type="object">Iranimij\OpenImport\Model\Import\Attribute\AttributeRecordReader</item>
                <item name="openimport_cms_page" xsi:type="object">OpenImportCmsPageReader</item>
                <item name="openimport_cms_block" xsi:type="object">OpenImportCmsBlockReader</item>
                <item name="openimport_shipment" xsi:type="object">Iranimij\OpenImport\Model\Import\Shipment\ShipmentRecordReader</item>
                <item name="openimport_url_rewrite" xsi:type="object">Iranimij\OpenImport\Model\Import\UrlRewrite\UrlRewriteRecordReader</item>
                <item name="openimport_cart_rule" xsi:type="object">OpenImportCartRuleReader</item>
                <item name="openimport_catalog_rule" xsi:type="object">OpenImportCatalogRuleReader</item>
                <item name="openimport_order" xsi:type="object">Iranimij\OpenImport\Model\Import\Order\OrderRecordReader</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="openimport_run" xsi:type="object">Iranimij\OpenImport\Console\Command\RunCommand</item>
                <item name="openimport_run_status" xsi:type="object">Iranimij\OpenImport\Console\Command\RunStatusCommand</item>
                <item name="openimport_profile_list" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfileListCommand</item>
                <item name="openimport_queue_run" xsi:type="object">Iranimij\OpenImport\Console\Command\QueueRunCommand</item>
                <item name="openimport_secrets_reencrypt" xsi:type="object">Iranimij\OpenImport\Console\Command\SecretsReencryptCommand</item>
                <item name="openimport_profiles_export" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfilesExportCommand</item>
                <item name="openimport_profiles_import" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfilesImportCommand</item>
                <item name="openimport_doctor" xsi:type="object">Iranimij\OpenImport\Console\Command\DoctorCommand</item>
            </argument>
        </arguments>
    </type>
    <!-- Commands are built on every bin/magento call: load their heavy dependencies only when they run. -->
    <type name="Iranimij\OpenImport\Console\Command\RunCommand">
        <arguments>
            <argument name="processor" xsi:type="object">Iranimij\OpenImport\Model\Execution\RunProcessor\Proxy</argument>
            <argument name="queue" xsi:type="object">Iranimij\OpenImport\Model\Execution\RunQueue\Proxy</argument>
            <argument name="profiles" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfileFinder\Proxy</argument>
            <argument name="report" xsi:type="object">Iranimij\OpenImport\Console\Command\RunReport\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\QueueRunCommand">
        <arguments>
            <argument name="processor" xsi:type="object">Iranimij\OpenImport\Model\Execution\RunProcessor\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\RunStatusCommand">
        <arguments>
            <argument name="runs" xsi:type="object">Iranimij\OpenImport\Api\RunRepositoryInterface\Proxy</argument>
            <argument name="report" xsi:type="object">Iranimij\OpenImport\Console\Command\RunReport\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\ProfilesExportCommand">
        <arguments>
            <argument name="profiles" xsi:type="object">Iranimij\OpenImport\Api\ProfileRepositoryInterface\Proxy</argument>
            <argument name="finder" xsi:type="object">Iranimij\OpenImport\Console\Command\ProfileFinder\Proxy</argument>
            <argument name="json" xsi:type="object">Iranimij\OpenImport\Model\Profile\ProfileJson\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\ProfilesImportCommand">
        <arguments>
            <argument name="json" xsi:type="object">Iranimij\OpenImport\Model\Profile\ProfileJson\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\DoctorCommand">
        <arguments>
            <argument name="indexers" xsi:type="object">Magento\Framework\Indexer\IndexerRegistry\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\SecretsReencryptCommand">
        <arguments>
            <argument name="profiles" xsi:type="object">Iranimij\OpenImport\Api\ProfileRepositoryInterface\Proxy</argument>
            <argument name="connections" xsi:type="object">Iranimij\OpenImport\Api\ConnectionRepositoryInterface\Proxy</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Console\Command\ProfileListCommand">
        <arguments>
            <argument name="profiles" xsi:type="object">Iranimij\OpenImport\Api\ProfileRepositoryInterface\Proxy</argument>
            <argument name="runs" xsi:type="object">Iranimij\OpenImport\Api\RunRepositoryInterface\Proxy</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="openimport_profile_listing_data_source" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Profile\Grid\Collection</item>
                <item name="openimport_run_listing_data_source" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Run\Grid\Collection</item>
                <item name="openimport_connection_listing_data_source" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Connection\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\ResourceModel\Connection\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">openimport_connection</argument>
            <argument name="resourceModel" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Connection</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\ResourceModel\Profile\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">openimport_profile</argument>
            <argument name="resourceModel" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Profile</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\ResourceModel\Run\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">openimport_run</argument>
            <argument name="resourceModel" xsi:type="string">Iranimij\OpenImport\Model\ResourceModel\Run</argument>
        </arguments>
    </type>

    <virtualType name="Iranimij\OpenImport\Ui\DataProvider\GridFilterPool"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Iranimij\OpenImport\Ui\DataProvider\KeywordFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Ui\DataProvider\GridDataProvider"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="filterPool" xsi:type="object">Iranimij\OpenImport\Ui\DataProvider\GridFilterPool</argument>
        </arguments>
    </virtualType>

    <type name="Iranimij\OpenImport\Model\Execution\SourceResolver">
        <arguments>
            <argument name="sources" xsi:type="array">
                <item name="upload" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\UploadSource</item>
                <item name="folder" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\FolderSource</item>
                <item name="url" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\UrlSource</item>
                <item name="sftp" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\SftpSource</item>
                <item name="ftp" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\FtpSource</item>
                <item name="s3" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\S3Source</item>
                <item name="google_drive" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\GoogleDriveSource</item>
                <item name="onedrive" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\OneDriveSource</item>
                <item name="rest" xsi:type="object">Iranimij\OpenImport\Model\Rest\RestSource</item>
                <item name="dropbox" xsi:type="object">Iranimij\OpenImport\Model\Execution\Source\DropboxSource</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\OAuth\OAuthFlow">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="google_drive" xsi:type="object">Iranimij\OpenImport\Model\Google\GoogleOAuthProvider</item>
                <item name="dropbox" xsi:type="object">Iranimij\OpenImport\Model\Dropbox\DropboxOAuthProvider</item>
                <item name="onedrive" xsi:type="object">Iranimij\OpenImport\Model\Microsoft\MicrosoftOAuthProvider</item>
            </argument>
        </arguments>
    </type>
    <!-- Kinds of saved connection; S3, Google, Dropbox, Microsoft and REST follow in 1.4. -->
    <type name="Iranimij\OpenImport\Model\Connection\ConnectionTypes">
        <arguments>
            <argument name="types" xsi:type="array">
                <item name="sftp" xsi:type="string">SFTP</item>
                <item name="ftp" xsi:type="string">FTP</item>
                <item name="s3" xsi:type="string">Amazon S3 / S3-compatible</item>
                <item name="google_drive" xsi:type="string">Google Drive / Sheets</item>
                <item name="dropbox" xsi:type="string">Dropbox</item>
                <item name="onedrive" xsi:type="string">OneDrive / SharePoint</item>
                <item name="rest" xsi:type="string">REST API</item>
            </argument>
            <argument name="inline" xsi:type="array">
                <item name="sftp" xsi:type="string">sftp</item>
                <item name="ftp" xsi:type="string">ftp</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Iranimij\OpenImport\Model\Config\Source\DestinationConnectionOptions"
                 type="Iranimij\OpenImport\Model\Config\Source\ConnectionOptions">
        <arguments>
            <argument name="typePath" xsi:type="string">export_options.destination</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Execution\Source\SftpSource" type="Iranimij\OpenImport\Model\Execution\Source\RemoteSource">
        <arguments>
            <argument name="protocol" xsi:type="string">sftp</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Execution\Source\S3Source" type="Iranimij\OpenImport\Model\Execution\Source\RemoteSource">
        <arguments>
            <argument name="protocol" xsi:type="string">s3</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Execution\Source\GoogleDriveSource" type="Iranimij\OpenImport\Model\Execution\Source\RemoteSource">
        <arguments>
            <argument name="protocol" xsi:type="string">google_drive</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Execution\Source\DropboxSource" type="Iranimij\OpenImport\Model\Execution\Source\RemoteSource">
        <arguments>
            <argument name="protocol" xsi:type="string">dropbox</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Execution\Source\OneDriveSource" type="Iranimij\OpenImport\Model\Execution\Source\RemoteSource">
        <arguments>
            <argument name="protocol" xsi:type="string">onedrive</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Execution\Source\FtpSource" type="Iranimij\OpenImport\Model\Execution\Source\RemoteSource">
        <arguments>
            <argument name="protocol" xsi:type="string">ftp</argument>
        </arguments>
    </virtualType>
    <type name="Iranimij\OpenImport\Model\Writer\WriterFactory">
        <arguments>
            <argument name="writers" xsi:type="array">
                <item name="csv" xsi:type="string">Iranimij\OpenImport\Model\Writer\CsvWriter</item>
                <item name="xlsx" xsi:type="string">Iranimij\OpenImport\Model\Writer\XlsxWriter</item>
                <item name="ods" xsi:type="string">Iranimij\OpenImport\Model\Writer\OdsWriter</item>
                <item name="json" xsi:type="string">Iranimij\OpenImport\Model\Writer\JsonWriter</item>
                <item name="xml" xsi:type="string">Iranimij\OpenImport\Model\Writer\XmlWriter</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\Export\EntitySourcePool">
        <arguments>
            <argument name="sources" xsi:type="array">
                <item name="openimport_order" xsi:type="object">Iranimij\OpenImport\Model\Export\Order\OrderEntitySource</item>
                <item name="openimport_category" xsi:type="object">Iranimij\OpenImport\Model\Import\Category\CategoryEntitySource</item>
                <item name="openimport_attribute" xsi:type="object">Iranimij\OpenImport\Model\Import\Attribute\AttributeEntitySource</item>
                <item name="openimport_cms_page" xsi:type="object">OpenImportCmsPageSource</item>
                <item name="openimport_cms_block" xsi:type="object">OpenImportCmsBlockSource</item>
                <item name="openimport_url_rewrite" xsi:type="object">Iranimij\OpenImport\Model\Import\UrlRewrite\UrlRewriteEntitySource</item>
                <item name="openimport_cart_rule" xsi:type="object">OpenImportCartRuleSource</item>
                <item name="openimport_catalog_rule" xsi:type="object">OpenImportCatalogRuleSource</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Iranimij\OpenImport\Model\Export\Destination\SftpDestination" type="Iranimij\OpenImport\Model\Export\Destination\RemoteDestination">
        <arguments>
            <argument name="protocol" xsi:type="string">sftp</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Export\Destination\S3Destination" type="Iranimij\OpenImport\Model\Export\Destination\RemoteDestination">
        <arguments>
            <argument name="protocol" xsi:type="string">s3</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Export\Destination\GoogleDriveDestination" type="Iranimij\OpenImport\Model\Export\Destination\RemoteDestination">
        <arguments>
            <argument name="protocol" xsi:type="string">google_drive</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Export\Destination\DropboxDestination" type="Iranimij\OpenImport\Model\Export\Destination\RemoteDestination">
        <arguments>
            <argument name="protocol" xsi:type="string">dropbox</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Export\Destination\OneDriveDestination" type="Iranimij\OpenImport\Model\Export\Destination\RemoteDestination">
        <arguments>
            <argument name="protocol" xsi:type="string">onedrive</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenImport\Model\Export\Destination\FtpDestination" type="Iranimij\OpenImport\Model\Export\Destination\RemoteDestination">
        <arguments>
            <argument name="protocol" xsi:type="string">ftp</argument>
        </arguments>
    </virtualType>
    <type name="Iranimij\OpenImport\Model\Export\DestinationPool">
        <arguments>
            <argument name="destinations" xsi:type="array">
                <item name="download" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\DownloadDestination</item>
                <item name="folder" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\FolderDestination</item>
                <item name="sftp" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\SftpDestination</item>
                <item name="ftp" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\FtpDestination</item>
                <item name="s3" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\S3Destination</item>
                <item name="google_drive" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\GoogleDriveDestination</item>
                <item name="onedrive" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\OneDriveDestination</item>
                <item name="rest" xsi:type="object">Iranimij\OpenImport\Model\Rest\RestDestination</item>
                <item name="dropbox" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\DropboxDestination</item>
                <item name="email" xsi:type="object">Iranimij\OpenImport\Model\Export\Destination\EmailDestination</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenImport\Model\Execution\Source\Remote\RemoteClientFactory">
        <arguments>
            <argument name="clients" xsi:type="array">
                <item name="sftp" xsi:type="string">Iranimij\OpenImport\Model\Execution\Source\Remote\SftpClient</item>
                <item name="ftp" xsi:type="string">Iranimij\OpenImport\Model\Execution\Source\Remote\FtpClient</item>
                <item name="s3" xsi:type="string">Iranimij\OpenImport\Model\Execution\Source\Remote\S3Client</item>
