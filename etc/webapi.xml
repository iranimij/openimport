<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/openimport/profiles/:profileId/runs" method="POST">
        <service class="Iranimij\OpenImport\Api\RunManagementInterface" method="start"/>
        <resources>
            <resource ref="Iranimij_OpenImport::run"/>
        </resources>
    </route>
    <route url="/V1/openimport/runs/:runId" method="GET">
        <service class="Iranimij\OpenImport\Api\RunManagementInterface" method="status"/>
        <resources>
            <resource ref="Iranimij_OpenImport::runs"/>
        </resources>
    </route>
</routes>
