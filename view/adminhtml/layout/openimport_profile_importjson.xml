<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Iranimij_OpenImport::css/openimport.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template" name="openimport.profile.import.json"
                   template="Iranimij_OpenImport::profile/import-json.phtml">
                <arguments>
                    <argument name="presets" xsi:type="object">Iranimij\OpenImport\ViewModel\Presets</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
