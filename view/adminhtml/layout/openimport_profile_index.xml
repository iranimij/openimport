<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Iranimij_OpenImport::css/openimport.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template" name="openimport.first_run" template="Iranimij_OpenImport::profile/first-run.phtml" before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Iranimij\OpenImport\ViewModel\FirstRun</argument>
                </arguments>
            </block>
            <uiComponent name="openimport_profile_listing"/>
        </referenceContainer>
    </body>
</page>
