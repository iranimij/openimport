<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">openimport_connection_form.openimport_connection_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Connection</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Iranimij\OpenImport\Block\Adminhtml\Profile\Edit\BackButton"/>
            <button name="delete" class="Iranimij\OpenImport\Block\Adminhtml\Connection\Edit\DeleteButton"/>
            <button name="save" class="Iranimij\OpenImport\Block\Adminhtml\Connection\Edit\SaveButton"/>
        </buttons>
        <namespace>openimport_connection_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>openimport_connection_form.openimport_connection_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="openimport_connection_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="openimport/connection/save"/>
        </settings>
        <aclResource>Iranimij_OpenImport::connections</aclResource>
        <dataProvider class="Iranimij\OpenImport\Ui\DataProvider\ConnectionFormDataProvider"
                      name="openimport_connection_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>connection_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="connection" sortOrder="10">
        <settings>
            <label translate="true">Connection</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="connection_id" formElement="hidden" sortOrder="1">
            <settings>
                <dataScope>connection_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
                <notice translate="true">Profiles show this name, e.g. "Supplier SFTP".</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
            </settings>
        </field>
        <field name="type" formElement="select" sortOrder="20">
            <settings>
                <label translate="true">For</label>
                <dataScope>type</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenImport\Model\Config\Source\ConnectionType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="host" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">sftp</item>
                        <item name="1" xsi:type="string">ftp</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Server</label>
                <dataScope>settings.host</dataScope>
                <placeholder>files.example.com</placeholder>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="port" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="31">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">sftp</item>
                        <item name="1" xsi:type="string">ftp</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Port</label>
                <dataScope>settings.port</dataScope>
                <additionalClasses>
                    <class name="openimport-narrow">true</class>
                </additionalClasses>
                <notice translate="true">Empty = 22 for SFTP, 21 for FTP.</notice>
            </settings>
        </field>
        <field name="username" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="32">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">sftp</item>
                        <item name="1" xsi:type="string">ftp</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">User name</label>
                <dataScope>settings.username</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="auth_sftp" component="Iranimij_OpenImport/js/form/source-select" formElement="select" sortOrder="33">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">sftp</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Login</label>
                <dataScope>settings.auth_sftp</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="0" xsi:type="array">
                                <item name="value" xsi:type="string">password</item>
                                <item name="label" xsi:type="string" translate="true">Password</item>
                            </option>
                            <option name="1" xsi:type="array">
                                <item name="value" xsi:type="string">key</item>
                                <item name="label" xsi:type="string" translate="true">Private key</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="password" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="34">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">sftp</item>
                        <item name="1" xsi:type="string">ftp</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="secret" xsi:type="boolean">true</item>
                    <item name="showWhen" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="type" xsi:type="array">
                                <item name="0" xsi:type="string">ftp</item>
                            </item>
                        </item>
                        <item name="1" xsi:type="array">
                            <item name="settings.auth_sftp" xsi:type="array">
                                <item name="not" xsi:type="array">
                                    <item name="0" xsi:type="string">key</item>
                                </item>
                            </item>
                        </item>
                    </item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Password</label>
                <dataScope>settings.password</dataScope>
                <notice translate="true">Stored encrypted, never shown again.</notice>
            </settings>
        </field>
        <field name="private_key" component="Iranimij_OpenImport/js/form/source-field" formElement="textarea" sortOrder="35">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">sftp</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="forAuth" xsi:type="array">
                        <item name="0" xsi:type="string">key</item>
                    </item>
                    <item name="authScope" xsi:type="string">settings</item>
                    <item name="authField" xsi:type="string">auth_sftp</item>
                    <item name="secret" xsi:type="boolean">true</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/secret-text</item>
                    <item name="placeholder" xsi:type="string">-----BEGIN OPENSSH PRIVATE KEY-----</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Private key</label>
                <dataScope>settings.private_key</dataScope>
                <notice translate="true">OpenSSH or PEM private key for key login. Stored encrypted, never shown again.</notice>
            </settings>
        </field>
        <field name="passphrase" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="36">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">sftp</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="forAuth" xsi:type="array">
                        <item name="0" xsi:type="string">key</item>
                    </item>
                    <item name="authScope" xsi:type="string">settings</item>
                    <item name="authField" xsi:type="string">auth_sftp</item>
                    <item name="secret" xsi:type="boolean">true</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Key passphrase</label>
                <dataScope>settings.passphrase</dataScope>
            </settings>
        </field>
        <field name="ssl" component="Iranimij_OpenImport/js/form/source-select" formElement="select" sortOrder="37">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">ftp</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Encryption (FTPS)</label>
                <dataScope>settings.ssl</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="0" xsi:type="array">
                                <item name="value" xsi:type="string">0</item>
                                <item name="label" xsi:type="string" translate="true">No</item>
                            </option>
                            <option name="1" xsi:type="array">
                                <item name="value" xsi:type="string">1</item>
                                <item name="label" xsi:type="string" translate="true">Explicit TLS (FTPS)</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="passive" component="Iranimij_OpenImport/js/form/source-checkbox" formElement="checkbox" sortOrder="38">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">ftp</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="default" xsi:type="string">1</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Passive mode</label>
                <dataScope>settings.passive</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="bucket" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">s3</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Bucket</label>
                <dataScope>settings.bucket</dataScope>
                <placeholder>shop-feeds</placeholder>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="region" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="41">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">s3</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Region</label>
                <dataScope>settings.region</dataScope>
                <placeholder>eu-central-1</placeholder>
                <notice translate="true">The AWS region of the bucket. S3-compatible services: the region they ask for, often us-east-1 or auto.</notice>
            </settings>
        </field>
        <field name="endpoint" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="42">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">s3</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Endpoint</label>
                <dataScope>settings.endpoint</dataScope>
                <placeholder>https://s3.eu-central-1.amazonaws.com</placeholder>
                <notice translate="true">Empty for Amazon S3. Cloudflare R2, Wasabi, MinIO, Garage and others: the address of the service.</notice>
            </settings>
        </field>
        <field name="path_style" component="Iranimij_OpenImport/js/form/source-checkbox" formElement="checkbox" sortOrder="43">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">s3</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Path-style addresses</label>
                <dataScope>settings.path_style</dataScope>
                <notice translate="true">endpoint/bucket/file instead of bucket.endpoint/file. Most self-hosted services need it.</notice>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="access_key" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="44">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">s3</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Access key</label>
                <dataScope>settings.access_key</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="secret_key" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="45">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">s3</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="secret" xsi:type="boolean">true</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Secret key</label>
                <dataScope>settings.secret_key</dataScope>
                <notice translate="true">Stored encrypted, never shown again.</notice>
            </settings>
        </field>
        <field name="auth_google" component="Iranimij_OpenImport/js/form/source-select" formElement="select" sortOrder="60">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">google_drive</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Log in as</label>
                <dataScope>settings.auth_google</dataScope>
                <notice translate="true">A service account suits servers (share the folders with its e-mail address); a Google account sees what that person sees.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="0" xsi:type="array">
                                <item name="value" xsi:type="string">service_account</item>
                                <item name="label" xsi:type="string" translate="true">Service account (JSON key)</item>
                            </option>
                            <option name="1" xsi:type="array">
                                <item name="value" xsi:type="string">oauth</item>
                                <item name="label" xsi:type="string" translate="true">Google account (sign in)</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="service_account_json" component="Iranimij_OpenImport/js/form/source-field" formElement="textarea" sortOrder="61">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">google_drive</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="showWhen" xsi:type="array">
                        <item name="settings.auth_google" xsi:type="array">
                            <item name="not" xsi:type="array">
                                <item name="0" xsi:type="string">oauth</item>
                            </item>
                        </item>
                    </item>
                    <item name="secret" xsi:type="boolean">true</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/secret-text</item>
                    <item name="placeholder" xsi:type="string">{"type": "service_account", ...}</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Service account key</label>
                <dataScope>settings.service_account_json</dataScope>
                <notice translate="true">The JSON key file of the service account (Google Cloud console › IAM › Service accounts › Keys). Stored encrypted, never shown again.</notice>
            </settings>
        </field>
        <field name="service_account_email" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="62">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">google_drive</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="showWhen" xsi:type="array">
                        <item name="service_account_note" xsi:type="array">
                            <item name="filled" xsi:type="string">1</item>
                        </item>
                        <item name="settings.auth_google" xsi:type="array">
                            <item name="not" xsi:type="array">
                                <item name="0" xsi:type="string">oauth</item>
                            </item>
                        </item>
                    </item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/text</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Share folders with</label>
                <dataScope>service_account_note</dataScope>
            </settings>
        </field>
        <field name="client_id" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="63">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">google_drive</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="showWhen" xsi:type="array">
                        <item name="settings.auth_google" xsi:type="array">
                            <item name="0" xsi:type="string">oauth</item>
                        </item>
                    </item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Client ID</label>
                <dataScope>settings.client_id</dataScope>
                <notice translate="true">Of an OAuth client of the type "Web application" in your Google Cloud project, with the Google Drive API switched on.</notice>
            </settings>
        </field>
        <field name="client_secret" component="Iranimij_OpenImport/js/form/source-field" formElement="input" sortOrder="64">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="forTypes" xsi:type="array">
                        <item name="0" xsi:type="string">google_drive</item>
                    </item>
                    <item name="forDirection" xsi:type="string">any</item>
                    <item name="typeField" xsi:type="string">type</item>
                    <item name="showWhen" xsi:type="array">
                        <item name="settings.auth_google" xsi:type="array">
                            <item name="0" xsi:type="string">oauth</item>
                        </item>
                    </item>
                    <item name="secret" xsi:type="boolean">true</item>
                    <item name="elementTmpl" xsi:type="string">Iranimij_OpenImport/form/source-field</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Client secret</label>
                <dataScope>settings.client_secret</dataScope>
