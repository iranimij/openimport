<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">openimport_connection_listing.openimport_connection_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add connection</label>
                <aclResource>Iranimij_OpenImport::connections</aclResource>
            </button>
        </buttons>
        <spinner>openimport_connection_columns</spinner>
        <deps>
            <dep>openimport_connection_listing.openimport_connection_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="openimport_connection_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">connection_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Iranimij_OpenImport::connections</aclResource>
        <dataProvider class="Iranimij\OpenImport\Ui\DataProvider\GridDataProvider"
                      name="openimport_connection_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>connection_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="openimport_connection_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">openimport_connection_listing.openimport_connection_listing.openimport_connection_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <column name="connection_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="type" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="Iranimij\OpenImport\Model\Config\Source\ConnectionType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">For</label>
            </settings>
        </column>
        <column name="server" class="Iranimij\OpenImport\Ui\Component\Listing\Column\ConnectionServer" sortOrder="40">
            <settings>
                <label translate="true">Server</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="used_by" class="Iranimij\OpenImport\Ui\Component\Listing\Column\ConnectionUsedBy" sortOrder="50">
            <settings>
                <label translate="true">Used by</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="60">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Changed</label>
                <fieldClass>
                    <class name="openimport-nowrap">true</class>
                </fieldClass>
            </settings>
        </column>
        <actionsColumn name="actions" class="Iranimij\OpenImport\Ui\Component\Listing\Column\ConnectionActions"
                       component="Iranimij_OpenImport/js/grid/columns/actions" sortOrder="200">
            <settings>
                <indexField>connection_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
