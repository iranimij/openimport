<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">openimport_profile_listing.openimport_profile_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add profile</label>
                <aclResource>Iranimij_OpenImport::profiles_edit</aclResource>
            </button>
        </buttons>
        <spinner>openimport_profile_columns</spinner>
        <deps>
            <dep>openimport_profile_listing.openimport_profile_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="openimport_profile_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">profile_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Iranimij_OpenImport::profiles</aclResource>
        <dataProvider class="Iranimij\OpenImport\Ui\DataProvider\GridDataProvider"
                      name="openimport_profile_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>profile_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="schedule_on">
                <settings>
                    <url path="openimport/profile/massSchedule">
                        <param name="on">1</param>
                    </url>
                    <type>schedule_on</type>
                    <label translate="true">Switch schedules on</label>
                </settings>
            </action>
            <action name="schedule_off">
                <settings>
                    <url path="openimport/profile/massSchedule">
                        <param name="on">0</param>
                    </url>
                    <type>schedule_off</type>
                    <label translate="true">Switch schedules off</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the chosen profiles? Their runs and error reports are kept.</message>
                        <title translate="true">Delete profiles</title>
                    </confirm>
                    <url path="openimport/profile/massSchedule">
                        <param name="delete">1</param>
                    </url>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="openimport_profile_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">openimport_profile_listing.openimport_profile_listing.openimport_profile_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids" sortOrder="0">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="fieldAction" xsi:type="boolean">false</item>
                </item>
            </argument>
            <settings>
                <indexField>profile_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="profile_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="direction" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="Iranimij\OpenImport\Model\Config\Source\Direction"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Direction</label>
            </settings>
        </column>
        <column name="entity" class="Iranimij\OpenImport\Ui\Component\Listing\Column\EntityName"
                component="Magento_Ui/js/grid/columns/column" sortOrder="40">
            <settings>
                <options class="Iranimij\OpenImport\Model\Config\Source\EntityFilter"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">What</label>
            </settings>
        </column>
        <column name="source_type" class="Iranimij\OpenImport\Ui\Component\Listing\Column\SourceOrDestination"
                component="Magento_Ui/js/grid/columns/column" sortOrder="50">
            <settings>
                <options class="Iranimij\OpenImport\Model\Config\Source\SourceType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Source / destination</label>
            </settings>
        </column>
        <column name="schedule" class="Iranimij\OpenImport\Ui\Component\Listing\Column\Schedule" sortOrder="60">
            <settings>
                <label translate="true">Schedule</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="last_run" class="Iranimij\OpenImport\Ui\Component\Listing\Column\LastRun" sortOrder="70">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="fieldAction" xsi:type="boolean">false</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Last run</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <fieldClass>
                    <class name="openimport-nowrap">true</class>
                </fieldClass>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Changed</label>
                <fieldClass>
                    <class name="openimport-nowrap">true</class>
                </fieldClass>
            </settings>
        </column>
        <actionsColumn name="actions" class="Iranimij\OpenImport\Ui\Component\Listing\Column\ProfileActions"
                       component="Iranimij_OpenImport/js/grid/columns/actions" sortOrder="200">
            <settings>
                <indexField>profile_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
